# =============================================================================
# Vibeforce Flow OS — Local / Development Environment Configuration
# =============================================================================
# Kopiere diese Datei zu .env und passe die Werte bei Bedarf an.

# -----------------------------------------------------------------------------
# 1. PocketBase Backend
# -----------------------------------------------------------------------------
# Interne Server-URL (für Next.js Server Components / Actions)
POCKETBASE_URL=http://127.0.0.1:8090

# Externe Client-URL (vom Browser aufgerufen)
NEXT_PUBLIC_POCKETBASE_URL=http://localhost:8090

# PocketBase Superuser / Admin Credentials
PB_ADMIN_EMAIL=admin@vibeforce.de
PB_ADMIN_PASSWORD=Generiere_Ein_Sicheres_Mindestens_16_Zeichen_Passwort_Hier!

# Demo-Gast-Zugänge (für /api/auth/demo) — starke, individuelle Passwörter setzen
DEMO_GUEST_A_EMAIL=guest_slot_a@vibeforce.de
DEMO_GUEST_A_PASSWORD=
DEMO_GUEST_B_EMAIL=guest_slot_b@vibeforce.de
DEMO_GUEST_B_PASSWORD=

# CORS & Allowed Origins
ALLOWED_ORIGINS=*

# -----------------------------------------------------------------------------
# 2. Frontend / App Konfiguration
# -----------------------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000
FRONTEND_PORT=3000
BACKEND_PORT=8090

# Standard-Stundensatz in EUR (für Zeiterfassung ohne projektspezifischen Satz)
NEXT_PUBLIC_DEFAULT_HOURLY_RATE=150

# -----------------------------------------------------------------------------
# 3. Optionale Erweiterungen & KI
# -----------------------------------------------------------------------------
DEEPSEEK_API_KEY=
