# =============================================================================
# Vibeforce Flow OS — Production Environment Configuration
# =============================================================================
# Kopiere diese Datei zu .env auf deinem Produktionsserver und setze starke Passwörter!

# -----------------------------------------------------------------------------
# 1. Domain & SSL (Traefik v3 + Let's Encrypt)
# -----------------------------------------------------------------------------
DOMAIN=vibeforce-flow.de
ACME_EMAIL=admin@vibeforce-flow.de

# -----------------------------------------------------------------------------
# 2. PocketBase Backend & Superuser
# -----------------------------------------------------------------------------
# Interne Docker-Netzwerk-URL für SSR / Server Actions
POCKETBASE_URL=http://backend:8080

# Öffentliche URL für den Browser-Zugriff
NEXT_PUBLIC_POCKETBASE_URL=https://pb.vibeforce-flow.de

# Superuser Credentials (BITTE ÄNDERN!)
PB_ADMIN_EMAIL=admin@vibeforce-flow.de
PB_ADMIN_PASSWORD=change-me-strong-password-min-24-chars

# Allowed Origins für CORS-Schutz
ALLOWED_ORIGINS=https://vibeforce-flow.de,https://pb.vibeforce-flow.de

# -----------------------------------------------------------------------------
# 3. Frontend Konfiguration
# -----------------------------------------------------------------------------
NODE_ENV=production
APP_URL=https://vibeforce-flow.de
NEXT_PUBLIC_DEFAULT_HOURLY_RATE=150

# -----------------------------------------------------------------------------
# 4. Optional: KI-Integration
# -----------------------------------------------------------------------------
DEEPSEEK_API_KEY=
