# =============================================================================
# Vibeforce — Production Environment Configuration (Two PB Instances)
# =============================================================================
# Kopiere diese Datei zu .env auf deinem Produktionsserver und setze starke Passwörter!
# Achtung: Es gibt zwei PocketBase-Instanzen: pb-flow und pb-craft.

# -----------------------------------------------------------------------------
# 1. Domain & SSL (Traefik v3 + Let's Encrypt)
# -----------------------------------------------------------------------------
DOMAIN=vibeforce-flow.de
ACME_EMAIL=admin@vibeforce-flow.de

# -----------------------------------------------------------------------------
# 2. PocketBase pb-flow Instance (Flow OS eigene Konfiguration)
# -----------------------------------------------------------------------------
# ALLOWED_ORIGINS für pb-flow (CORS & PocketBase --origins)
ALLOWED_ORIGINS_FLOW=https://vibeforce-flow-os.vercel.app,https://rl-showcase.vercel.app
# Superuser Credentials für pb-flow (BITTE ÄNDERN!)
PB_ADMIN_EMAIL_FLOW=flow-admin@vibeforce.flow.de
PB_ADMIN_PASSWORD_FLOW=STARKE_ZUFALLSPASSWORT_MIN_24_CHARS_FLOW
# Demo-Gäste für pb-flow (BITTE ÄNDERN!)
DEMO_GUEST_A_EMAIL_FLOW=demo-flow-a@vibeforce.flow.de
DEMO_GUEST_A_PASSWORD_FLOW=STARKE_ZUFALLSPASSWORT_FLOW_A
DEMO_GUEST_B_EMAIL_FLOW=demo-flow-b@vibeforce.flow.de
DEMO_GUEST_B_PASSWORD_FLOW=STARKE_ZUFALLSPASSWORT_FLOW_B

# -----------------------------------------------------------------------------
# 3. PocketBase pb-craft Instance (zusätzlich mitlaufen)
# -----------------------------------------------------------------------------
# ALLOWED_ORIGINS für pb-craft (CORS & PocketBase --origins)
ALLOWED_ORIGINS_CRAFT=https://vibeforce-craft-os.vercel.app,https://craft-vibeforce.vercel.app,https://rl-showcase.vercel.app
# Superuser Credentials für pb-craft (BITTE ÄNDERN!)
PB_ADMIN_EMAIL_CRAFT=craft-admin@vibeforce.craft.de
PB_ADMIN_PASSWORD_CRAFT=STARKE_ZUFALLSPASSWORT_MIN_24_CHARS_CRAFT
# Demo-Gäste für pb-craft (BITTE ÄNDERN!)
DEMO_GUEST_A_EMAIL_CRAFT=demo-craft-a@vibeforce.craft.de
DEMO_GUEST_A_PASSWORD_CRAFT=STARKE_ZUFALLSPASSWORT_CRAFT_A
DEMO_GUEST_B_EMAIL_CRAFT=demo-craft-b@vibeforce.craft.de
DEMO_GUEST_B_PASSWORD_CRAFT=STARKE_ZUFALLSPASSWORT_CRAFT_B

# -----------------------------------------------------------------------------
# 4. Interne Docker-Netzwerk-URL für SSR / Server Actions
# -----------------------------------------------------------------------------
POCKETBASE_URL=http://backend:8080

# -----------------------------------------------------------------------------
# 5. Öffentliche URL für den Browser-Zugriff (pb-flow)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_POCKETBASE_URL_FLOW=https://pb-flow.vibeforce.46-225-178-235.sslip.io

# -----------------------------------------------------------------------------
# 6. Frontend Konfiguration
# -----------------------------------------------------------------------------
NODE_ENV=production
APP_URL=https://vibeforce-flow.de
NEXT_PUBLIC_DEFAULT_HOURLY_RATE=150

# -----------------------------------------------------------------------------
# 7. Optional: KI-Integration
# -----------------------------------------------------------------------------
DEEPSEEK_API_KEY=
