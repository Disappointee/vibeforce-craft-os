#!/bin/sh
# Secret-Scan vor dem Commit — Wiederkehr-Schutz (Block 4, 2026-10-22)
#
# Blockt Commits, die potenzielle Secrets enthalten.
# 1. Wahl: gitleaks (PATH oder WinGet-Portable-Installation)
# 2. Fallback: Regex-Scan der gestagten Änderungen (fail-closed bei Treffern)
#
# Installation im Klon:  cp tools/git-hooks/pre-commit .git/hooks/pre-commit
# Manueller Lauf:        gitleaks git --staged --redact

set -u

GITLEAKS=""
if command -v gitleaks >/dev/null 2>&1; then
  GITLEAKS="gitleaks"
else
  for cand in "${LOCALAPPDATA:-}/Microsoft/WinGet/Packages/"Gitleaks.Gitleaks_*/gitleaks.exe; do
    if [ -f "$cand" ]; then GITLEAKS="$cand"; break; fi
  done
fi

if [ -n "$GITLEAKS" ]; then
  if ! "$GITLEAKS" git --staged --no-banner --redact --exit-code 1 .; then
    echo "[pre-commit] BLOCKIERT: gitleaks hat potenzielle Secrets in den gestagten Aenderungen gefunden." >&2
    echo "[pre-commit] Details ansehen: gitleaks git --staged --redact" >&2
    echo "[pre-commit] Falsch-Positiv? Datei bereinigen oder 'gitleaks:allow' am Fundort setzen." >&2
    exit 1
  fi
  exit 0
fi

echo "[pre-commit] Hinweis: gitleaks nicht gefunden - Fallback-Regex-Scan laeuft." >&2
if git diff --cached -U0 | grep -E '^\+' | grep -vE '^\+\+\+' | grep -qE '(sk-(ant-|proj-)?[A-Za-z0-9_-]{20,}|ghp_[A-Za-z0-9]{20,}|gho_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|AIza[0-9A-Za-z_-]{35}|AKIA[0-9A-Z]{16}|-----BEGIN [A-Z ]*PRIVATE KEY-----|eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,})'; then
  echo "[pre-commit] BLOCKIERT: Muster eines echten Secrets in den gestagten Aenderungen gefunden." >&2
  exit 1
fi
exit 0
